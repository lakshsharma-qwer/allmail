# Port for the API server (the built UI is served from here too in production)
PORT=4000

# Public URL people reach this app at. Used in open-tracking pixels, click links
# and unsubscribe links inside emails. Must be reachable by your recipients for
# tracking/unsubscribe to work (use your domain or a tunnel such as ngrok in dev).
APP_URL=http://localhost:4000

# Secret used to sign login tokens and encrypt stored SMTP passwords.
# Leave empty to auto-generate one into data/secret.key on first start.
# Changing it later makes stored SMTP passwords unreadable.
APP_SECRET=
